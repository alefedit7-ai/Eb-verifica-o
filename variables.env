# ==========================================================
#  BOT DE VERIFICAÇÃO — EB  |  Configuração (copie para .env)
#  Em hospedagens/celular onde arquivos com ponto somem,
#  use o arquivo "variables.env" (mesmo conteúdo).
# ==========================================================

# ---------- OBRIGATÓRIAS ----------
# Token do bot: Discord Developer Portal > seu app > Bot > Reset Token
DISCORD_TOKEN=MTU2MDQ0MTQzNzU0NjQ4NzkxMA.G_R-Qe.uQ07I7szey05K3oTsfxfzcTHTChZubgZK9mPdE

# Seu ID de usuário do Discord (donos do bot). Vários: separe por vírgula.
# Donos podem ativar/desativar a integração central dos servidores.
BOT_OWNER_IDS=1517685654522433736 , 1507851973230330008

# ---------- OPCIONAIS ----------
# Lista de servidores permitidos (IDs separados por vírgula).
# Se preenchida, o bot ignora qualquer servidor fora da lista.
ALLOWED_GUILD_IDS=1559904501186699345

# Caminho do banco SQLite (padrão: ./data/eb-verificacao.sqlite)
DATABASE_PATH=

# ---------- CONFIGURAÇÃO INICIAL DO SERVIDOR PRINCIPAL ----------
# Usada SOMENTE na primeira vez (se o servidor ainda não tiver configuração).
# Depois disso, tudo é alterado pelo comando /configurar.
GUILD_ID_PRINCIPAL=1559904501186699345
CANAL_PAINEL_ID=1559904504084693020
CANAL_LOGS_ID=
CARGO_VERIFICADO_ID=1560272749321261066
CARGOS_ADMIN_IDS=1559904502310633580

# ---------- AVANÇADO ----------
# true = ativa o intent "Server Members" (precisa ser ligado no Developer Portal).
# Com ele, quem já foi verificadoFb em outro servidor autorizado recebe o cargo
# automaticamente ao entrar (se o servidor aceitar verificações de outros).
USAR_INTENT_MEMBROS=false

# Validade do código de vinculação, em minutos (padrão 10)
CODIGO_VALIDADE_MIN=10

# Se a hospedagem for bloqueada pela Roblox, troque por proxies, ex.:
# ROBLOX_USERS_API=https://users.roproxy.com
# ROBLOX_GROUPS_API=https://groups.roproxy.com
ROBLOX_USERS_API=https://users.roblox.com
ROBLOX_GROUPS_API=https://groups.roblox.com

# A conta precisa pertencer a pelo menos um destes grupos Roblox.
ROBLOX_GROUP_IDS=866282850,1042231911,728691851,245426392,1073002614,781548145
ROBLOX_REQUIRE_ANY_GROUP=true
